+    def predict_batched(self, x, valid_lens, segment_ids, audio_attn_mask,
+                        text_ids=None, text_attn_mask=None, layer_index=1, iter_step=1):
+        '''
+        Batched counterpart of `predict`. Refines residual layer `layer_index`
+        for a whole padded batch in one transformer forward per iteration.
+
+        x:               [B, n_codebook, t]  (long) padded acoustic/semantic codes
+        valid_lens:      [B]                 real length (st_len + at_len) per sample
+        segment_ids:     [B, t]              1=ST, 2=AT, 0=pad
+        audio_attn_mask: [B, t]              1 for valid positions, 0 for pad
+        layer_index:     int (same residual layer for the whole batch)
+
+        Only the confidence-based selection/scatter is done per-sample (cheap,
+        no transformer); the expensive forward is fully batched.
+        '''
+        batch_size, n_codebook, t = x.size()
+        assert n_codebook == self.hp.at_res_num, f"n_codebook: {n_codebook} != {self.hp.at_res_num}"
+        device = x.device
+        li = int(layer_index)
+        layer_index_t = torch.full((batch_size,), li, dtype=torch.long, device=device)
+
+        # text embeddings (batched)
+        t5_outputs = self.t5_model(input_ids=text_ids, attention_mask=text_attn_mask)
+        text_encode = self.prompt_fc(t5_outputs.last_hidden_state)
+        text_encode = torch.where(
+            (text_attn_mask > 0).unsqueeze(-1),
+            text_encode,
+            torch.zeros_like(text_encode, device=device),
+        )
+
+        st_lens = (segment_ids == 1).sum(dim=1)  # [B]
+        pos = torch.arange(t, device=device).unsqueeze(0)  # [1, t]
+        # positions to predict: AT region within the valid length
+        mask_to_predict = (st_lens.unsqueeze(1) <= pos) & (pos < valid_lens.unsqueeze(1))  # [B, t] bool
+        num_to_mask = mask_to_predict.sum(dim=1).float()  # [B]
+        num_to_mask_pre = torch.zeros(batch_size, device=device)  # [B]
+
+        extend_segment_ids = torch.cat(
+            [torch.zeros_like(text_ids, device=device), segment_ids], dim=1)
+        extend_attention_mask = torch.cat(
+            [text_attn_mask, audio_attn_mask], dim=1)
+
+        for k in range(iter_step):
+            frac = 1 - math.cos(math.pi / 2 * (k + 1) / iter_step)
+            num_to_mask_step = torch.ceil(
+                num_to_mask * frac - num_to_mask_pre).clamp(min=0).long()  # [B]
+
+            inputs_embeds = self.embed_res(layer_index_t - 1).unsqueeze(1)
+            for i in range(n_codebook):
+                inputs_embeds = self.all_embed_tokens[i](x[:, i, :]) + inputs_embeds
+
+            extend_inputs_embeds = torch.cat([text_encode, inputs_embeds], dim=1)
+            extend_inputs_embeds += self.embed_segments(extend_segment_ids)
+
+            hidden_outputs = self.model(
+                inputs_embeds=extend_inputs_embeds,
+                attention_mask=extend_attention_mask,
+            ).last_hidden_state[:, self.hp.max_text_len:, :]
+
+            logits = self.out_proj[li - 1](hidden_outputs)  # [B, t, vocab]
+
+            logits_confid = F.softmax(logits, dim=-1).max(dim=-1).values.detach()
+            pred_logits_confidence = logits_confid * mask_to_predict.float()
+            _, inds = torch.sort(pred_logits_confidence, dim=1, descending=True)  # [B, t]
+            pred_toks = logits.argmax(dim=-1) + self.hp.st_token_num + self.hp.lang_num + 1
+
+            for b in range(batch_size):
+                kstep = int(num_to_mask_step[b])
+                if kstep <= 0:
+                    continue
+                sel = inds[b, :kstep]  # top-confidence still-masked positions
+                x[b, li, sel] = pred_toks[b, sel]
+                mask_to_predict[b, sel] = False
+
+            num_to_mask_pre += num_to_mask_step.float()
+
+        return x
     
